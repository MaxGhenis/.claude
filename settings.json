{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 3650,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CALLME_PHONE_PROVIDER": "telnyx",
    "CALLME_PHONE_ACCOUNT_SID": "${CALLME_PHONE_ACCOUNT_SID}",
    "CALLME_PHONE_AUTH_TOKEN": "${CALLME_PHONE_AUTH_TOKEN}",
    "CALLME_PHONE_NUMBER": "${CALLME_PHONE_NUMBER}",
    "CALLME_USER_PHONE_NUMBER": "${CALLME_USER_PHONE_NUMBER}",
    "CALLME_OPENAI_API_KEY": "${OPENAI_API_KEY}",
    "CALLME_NGROK_AUTHTOKEN": "${CALLME_NGROK_AUTHTOKEN}",
    "CLAUDE_CODE_EFFORT_LEVEL": "max"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Edit(**)",
      "Write",
      "Read",
      "Read(**)",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "NotebookEdit",
      "Skill",
      "Task",
      "Task(*)",
      "mcp__slack__*",
      "mcp__whatsapp__*",
      "mcp__claude-in-chrome__*",
      "mcp__google-ads__execute_gaql",
      "mcp__google-ads__get_account_overview",
      "mcp__google-ads__get_campaign_performance",
      "mcp__google-ads__get_keyword_performance",
      "mcp__google-ads__list_ad_groups",
      "mcp__google-ads__list_ads",
      "mcp__google-ads__list_campaigns",
      "mcp__google-ads__list_keywords",
      "mcp__openmessage__*",
      "mcp__granola__*",
      "mcp__granola-local__*"
    ],
    "deny": [],
    "ask": [
      "mcp__google-ads__add_*",
      "mcp__google-ads__create_*",
      "mcp__google-ads__enable_*",
      "mcp__google-ads__pause_*",
      "mcp__google-ads__update_*",
      "mcp__google-ads__delete_*",
      "mcp__google-ads__remove_*",
      "mcp__google-ads__set_*",
      "mcp__google-ads__mutate_*"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/maxghenis/.claude/hooks/enforce-package-managers.sh"
          }
        ]
      },
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/maxghenis/.claude/hooks/gitnexus/gitnexus-hook.cjs\"",
            "timeout": 10,
            "statusMessage": "Enriching with GitNexus graph context..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/maxghenis/.claude/hooks/auto-commit-wip.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/maxghenis/.claude/hooks/warn-uncommitted.sh"
          },
          {
            "type": "command",
            "command": "/Users/maxghenis/.claude/hooks/verify-should-work.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/maxghenis/.agentboard/hook.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/maxghenis/.claude/hooks/sync-setup-page.sh"
          },
          {
            "type": "command",
            "command": "/Users/maxghenis/.claude/hooks/gmail-draft-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/maxghenis/.claude/hooks/check-model-downgrade.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/maxghenis/.claude/hooks/check-model-downgrade.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/maxghenis/.claude/hooks/ensure-plugin-manifests.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/maxghenis/chief-of-staff/ai-quota/bin/claude-statusline.py"
  },
  "enabledPlugins": {
    "plugin-dev@claude-code-plugins": true,
    "academic-referee@maxghenis-plugins": true,
    "code-simplifier@claude-plugins-official": false,
    "complete@policyengine-claude": false,
    "rules-foundation@rules-foundation": true,
    "codex-bridge@maxghenis-plugins": true,
    "vercel@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "ultracode": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "teammateMode": "in-process",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754133980561
  }
}
