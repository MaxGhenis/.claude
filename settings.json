{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 3650,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CALLME_PHONE_PROVIDER": "telnyx",
    "CALLME_PHONE_ACCOUNT_SID": "${CALLME_PHONE_ACCOUNT_SID}",
    "CALLME_PHONE_AUTH_TOKEN": "${CALLME_PHONE_AUTH_TOKEN}",
    "CALLME_PHONE_NUMBER": "${CALLME_PHONE_NUMBER}",
    "CALLME_USER_PHONE_NUMBER": "${CALLME_USER_PHONE_NUMBER}",
    "CALLME_OPENAI_API_KEY": "${OPENAI_API_KEY}",
    "CALLME_NGROK_AUTHTOKEN": "${CALLME_NGROK_AUTHTOKEN}",
    "CLAUDE_CODE_EFFORT_LEVEL": "max"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Edit(**)",
      "Write",
      "Write(**)",
      "Read",
      "Read(**)",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "NotebookEdit",
      "Skill",
      "Task",
      "Task(*)",
      "mcp__slack__*",
      "mcp__whatsapp__*",
      "mcp__claude-in-chrome__*",
      "mcp__callme__*",
      "mcp__gmail__*",
      "mcp__google-ads__*",
      "mcp__openmessage__*",
      "mcp__granola__*",
      "mcp__granola-local__*"
    ],
    "deny": [],
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/maxghenis/.claude/hooks/enforce-package-managers.sh"
          }
        ]
      },
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/maxghenis/.claude/hooks/gitnexus/gitnexus-hook.cjs\"",
            "timeout": 10,
            "statusMessage": "Enriching with GitNexus graph context..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/maxghenis/.claude/hooks/auto-commit-wip.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/maxghenis/.claude/hooks/warn-uncommitted.sh"
          },
          {
            "type": "command",
            "command": "/Users/maxghenis/.claude/hooks/verify-should-work.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/maxghenis/.agentboard/hook.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/maxghenis/.claude/hooks/sync-setup-page.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/maxghenis/.claude/hooks/ensure-plugin-manifests.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "cosilico@cosilico": true,
    "plugin-dev@claude-code-plugins": true,
    "academic-referee@maxghenis-plugins": true,
    "code-simplifier@claude-plugins-official": true,
    "complete@policyengine-claude": true,
    "rules-foundation@rules-foundation": true,
    "codex-bridge@maxghenis-plugins": true,
    "vercel@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "ultracode": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "teammateMode": "in-process",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "mcpServers": {
    "gitnexus": {
      "command": "/opt/homebrew/bin/node",
      "args": [
        "/Users/maxghenis/.local/share/gitnexus/node_modules/.bin/gitnexus",
        "mcp"
      ]
    },
    "gmail": {
      "command": "/bin/bash",
      "args": [
        "-c",
        "source ~/.nvm/nvm.sh && nvm use 20 > /dev/null && node /Users/maxghenis/Github/Gmail-MCP-Server/dist/index.js"
      ]
    },
    "google-ads": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/Users/maxghenis/tmp/google-ads-mcp-complete",
        "python",
        "-m",
        "google_ads_mcp_complete.fastmcp_server"
      ],
      "env": {
        "GOOGLE_ADS_CONFIG_PATH": "/Users/maxghenis/.config/google-ads-mcp/config.json"
      }
    },
    "openmessage": {
      "type": "sse",
      "url": "http://localhost:7007/mcp/sse"
    },
    "granola-local": {
      "command": "/Users/maxghenis/GranolaMCP/.venv/bin/python",
      "args": [
        "-m",
        "granola_mcp.mcp"
      ]
    }
  },
  "feedbackSurveyState": {
    "lastShownTime": 1754133980561
  },
  "pluginSources": {
    "callme": "/Users/maxghenis/call-me/.claude-plugin"
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/maxghenis/chief-of-staff/ai-quota/bin/claude-statusline.py"
  }
}